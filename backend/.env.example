# ==============================================================================
# Fyndo Backend Environment Template (Render & Production)
# ==============================================================================

ENVIRONMENT=production
PROJECT_NAME="Fyndo API"
PORT=5000

# PostgreSQL Connection String (Asyncpg)
# Render Internal DB string: postgresql://fyndo_user:password@dpg-xxx:5432/fyndo_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fyndo_db

# Redis Connection String
REDIS_URL=redis://localhost:6379
REDIS_REQUIRED=false

# JWT Authentication Secrets (32+ chars each)
JWT_ACCESS_SECRET=your_32_character_long_access_secret_key_here
JWT_REFRESH_SECRET=your_32_character_long_refresh_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Initial Super Admin Master Credentials
SUPER_ADMIN_IDENTIFIER=+919999900000
SUPER_ADMIN_EMAIL=admin@fyndo.in
SUPER_ADMIN_PASSWORD=AdminFyndo@2026

# Allowed Frontend Origins for CORS (comma-separated)
BACKEND_CORS_ORIGINS=https://fyndo-frontend.onrender.com,http://localhost:3000

# Cloudinary CDN Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# OTP & Push Provider (mock | twilio | gupshup | expo)
SMS_GATEWAY_PROVIDER=mock
PUSH_PROVIDER=mock
