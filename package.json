{
  "name": "fyndo",
  "version": "1.0.0",
  "private": true,
  "description": "Fyndo - Hyper-Local Video Discovery & In-Store Digital Coupon Platform",
  "scripts": {
    "dev": "python run_dev.py",
    "start": "python run_dev.py",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --reload --port 5000",
    "dev:frontend": "cd frontend && npm run dev",
    "test:backend": "cd backend && pytest -v",
    "build:frontend": "cd frontend && npm run build",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down"
  }
}
