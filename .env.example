# Fyndo Environment Variables Template
# Copy to .env and fill in real values. NEVER commit real secrets.

NODE_ENV=development
ENVIRONMENT=development
PORT=5000

# Database (PostgreSQL 16 + PostGIS - Asyncpg)
DATABASE_URL=postgresql+asyncpg://fyndo_user:fyndo_secure_password@localhost:5432/fyndo_db

# Redis (Sessions, OTP, Rate Limiting). Required in production.
REDIS_URL=redis://localhost:6379
REDIS_REQUIRED=false

# JWT Authentication — generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_ACCESS_SECRET=replace_me_with_a_48_char_random_value
JWT_REFRESH_SECRET=replace_me_with_a_different_48_char_random_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Super Admin Master Credentials (minimum 10 characters, required in production)
SUPER_ADMIN_IDENTIFIER=+919999900000
SUPER_ADMIN_EMAIL=admin@fyndo.in
SUPER_ADMIN_PASSWORD=replace_me_with_a_strong_admin_password

# Cloudinary Media Storage & CDN (Videos, Thumbnails & KYC Documents)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# SMS / WhatsApp OTP Gateway (Twilio / Gupshup)
SMS_GATEWAY_PROVIDER=mock # mock | twilio | gupshup
SMS_GATEWAY_API_KEY=

# CORS — comma separated allow-list. Wildcards are rejected in production.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Media pipeline limits
UPLOAD_ROOT=uploads
MEDIA_MAX_VIDEO_MB=60
MEDIA_MAX_IMAGE_MB=8

# Rate limiting
ENABLE_RATE_LIMITING=true
FEED_RATE_LIMIT_PER_MIN=60
POS_RATE_LIMIT_PER_MIN=30
MAX_REQUEST_BYTES=83886080

# Structured logging (console always; size-rotated files when LOG_TO_FILE)
# LOG_FORMAT: leave blank to auto-select (JSON in production, human text in dev)
LOG_LEVEL=INFO
LOG_FORMAT=
LOG_TO_FILE=true
LOG_DIR=logs
LOG_FILE_NAME=fyndo.log
AUDIT_FILE_NAME=audit.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Push notifications (Expo Push Service fronts FCM + APNs)
# PUSH_PROVIDER: mock (log only) | expo (live) | fcm
PUSH_ENABLED=true
PUSH_PROVIDER=mock
EXPO_ACCESS_TOKEN=
PUSH_TIMEOUT_SECONDS=5.0

# Notification inbox
NOTIFICATION_RETENTION_DAYS=14
NOTIFICATION_PAGE_SIZE=30
